{
  "name": "bridge",
  "private": true,
  "version": "0.1.0",
  "description": "BRIDGE - レストラン注文・呼び出し・会計システム",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:front": "npm run dev -w @bridge/front-system",
    "dev:back": "npm run dev -w @bridge/back-system",
    "build": "npm run build -w @bridge/front-system && npm run build -w @bridge/back-system",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
