# 各アプリの .env に配置する(apps/front-system/.env, apps/back-system/.env)
# Supabase ダッシュボード > Project Settings > API から取得
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 注意: service_role キーと DB パスワードは絶対にここに書かない。
# それらは Supabase Edge Functions と GitHub Actions Secrets にのみ設定する。
